{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hunghsuan-com",
	"compatibility_date": "2026-07-28",
	"main": "./src/worker.js",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "hunghsuan.com",
			"custom_domain": true
		},
		{
			"pattern": "www.hunghsuan.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true
	}
}
