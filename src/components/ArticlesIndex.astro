---
import { getCollection } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

interface Props {
	lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const isZh = lang === 'zh';
const t = (zh: string, en: string) => (isZh ? zh : en);
const includeDrafts = import.meta.env.DEV;
const articles = (
	await getCollection(
		'articles',
		({ data }) => data.lang === lang && (includeDrafts || !data.draft),
	)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const dateFormatter = new Intl.DateTimeFormat(isZh ? 'zh-TW' : 'en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
const title = t('文章與攻略', 'Articles & Guides');
const description = t(
	'Hunghsuan（帶哥）分享的三角洲行動攻略、遊戲理解與內容創作筆記。',
	'Delta Force guides, game insights, and creator notes from Hunghsuan.',
);
---

<ArticleLayout
	lang={lang}
	title={title}
	description={description}
	canonicalPath={`/${lang}/articles/`}
	translationPath={`/${isZh ? 'en' : 'zh'}/articles/`}
>
	<main class="articles-main">
		<header class="articles-hero">
			<div class="articles-kicker" data-reveal="left">
				<span>04</span>
				<span>{t('文章資料庫', 'FIELD NOTES')}</span>
			</div>
			<h1 data-reveal>{title}</h1>
			<p data-reveal style="--reveal-delay: 90ms;">{description}</p>
		</header>

		<section class="articles-section" aria-labelledby="articles-list-title">
			<div class="articles-section-heading" data-reveal>
				<h2 id="articles-list-title">{t('最新文章', 'LATEST ARTICLES')}</h2>
				<span>{String(articles.length).padStart(2, '0')}</span>
			</div>

			{
				articles.length > 0 ? (
					<div class="articles-list">
						{articles.map((article, index) => (
							<a
								class="article-card"
								href={`/${lang}/articles/${article.data.articleSlug}/`}
								data-reveal
								style={`--reveal-delay: ${(index % 3) * 70}ms;`}
							>
								<div class="article-card-index">
									<span>{String(index + 1).padStart(2, '0')}</span>
									<span>{article.data.category}</span>
								</div>
								<div class="article-card-copy">
									<div class="article-card-meta">
										<time datetime={article.data.publishedAt.toISOString()}>
											{dateFormatter.format(article.data.publishedAt)}
										</time>
										{article.data.draft && <span class="draft-badge">{t('草稿', 'DRAFT')}</span>}
									</div>
									<h3>{article.data.title}</h3>
									<p>{article.data.description}</p>
								</div>
								<span class="article-card-arrow" aria-hidden="true">↘</span>
							</a>
						))}
					</div>
				) : (
					<div class="articles-empty" data-reveal>
						<p>{t('第一篇攻略正在準備中。', 'The first guide is in progress.')}</p>
						<a href={`/${lang}/`}>{t('先看看我的精選影片', 'Explore my featured videos')} →</a>
					</div>
				)
			}
		</section>
	</main>
</ArticleLayout>

<style>
	.articles-main {
		min-height: calc(100vh - 84px);
	}

	.articles-hero {
		display: grid;
		grid-template-columns: minmax(0, 0.45fr) minmax(0, 1.1fr);
		gap: 32px clamp(40px, 8vw, 130px);
		padding: clamp(76px, 10vw, 148px) clamp(24px, 7vw, 112px);
		border-bottom: 1px solid var(--line);
	}

	.articles-kicker {
		display: flex;
		align-items: center;
		align-self: start;
		gap: 16px;
		padding-top: 14px;
		color: var(--accent-text);
		font-size: 0.6rem;
		font-weight: 850;
		letter-spacing: 0.2em;
	}

	.articles-kicker > span:first-child {
		display: grid;
		width: 28px;
		height: 28px;
		place-items: center;
		border: 1px solid currentColor;
		border-radius: 50%;
		font-family: var(--serif);
		font-style: italic;
		letter-spacing: 0;
	}

	.articles-hero h1 {
		margin: 0;
		font-size: clamp(3.8rem, 9vw, 9rem);
		font-weight: 900;
		letter-spacing: -0.08em;
		line-height: 0.84;
	}

	.articles-hero p {
		grid-column: 2;
		max-width: 680px;
		margin: 12px 0 0;
		font-family: var(--serif);
		font-size: clamp(1.1rem, 1.8vw, 1.45rem);
		line-height: 1.7;
	}

	.articles-section {
		padding: clamp(72px, 9vw, 130px) clamp(24px, 7vw, 112px);
	}

	.articles-section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 24px;
		padding-bottom: 22px;
		border-bottom: 1px solid var(--line-strong);
	}

	.articles-section-heading h2 {
		margin: 0;
		font-size: clamp(1.6rem, 3.5vw, 3.4rem);
		letter-spacing: -0.05em;
	}

	.articles-section-heading > span {
		font-family: var(--serif);
		font-size: 0.82rem;
		font-style: italic;
	}

	.article-card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(120px, 0.35fr) minmax(0, 1fr) auto;
		gap: clamp(26px, 5vw, 80px);
		padding: clamp(28px, 4vw, 52px) 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		transition: padding 180ms ease;
	}

	.article-card:hover,
	.article-card:focus-visible {
		padding-right: 12px;
		padding-left: 12px;
	}

	.article-card-index,
	.article-card-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 10px 18px;
		color: var(--accent-text);
		font-size: 0.58rem;
		font-weight: 850;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.article-card-index {
		align-content: flex-start;
		justify-content: space-between;
		padding-top: 5px;
	}

	.article-card h3 {
		max-width: 800px;
		margin: 15px 0 12px;
		font-family: var(--serif);
		font-size: clamp(1.7rem, 3.2vw, 3.2rem);
		font-weight: 500;
		line-height: 1.1;
	}

	.article-card p {
		max-width: 680px;
		margin: 0;
		color: var(--muted);
	}

	.draft-badge {
		padding: 3px 7px;
		color: var(--forest-deep);
		background: var(--acid);
	}

	.article-card-arrow {
		align-self: center;
		font-size: 1.4rem;
		transition: transform 180ms ease;
	}

	.article-card:hover .article-card-arrow,
	.article-card:focus-visible .article-card-arrow {
		transform: translate(4px, 4px);
	}

	.articles-empty {
		padding: clamp(56px, 8vw, 100px) 0;
		text-align: center;
	}

	.articles-empty p {
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(1.7rem, 4vw, 3.2rem);
	}

	.articles-empty a {
		display: inline-block;
		margin-top: 26px;
		color: var(--accent-text);
		font-size: 0.65rem;
		font-weight: 850;
		letter-spacing: 0.13em;
		text-underline-offset: 5px;
	}

	@media (max-width: 720px) {
		.articles-hero {
			grid-template-columns: 1fr;
		}

		.articles-hero p {
			grid-column: 1;
		}

		.article-card {
			grid-template-columns: 1fr auto;
		}

		.article-card-index {
			grid-column: 1 / -1;
			justify-content: flex-start;
		}
	}
</style>
