---
import { getCollection } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import LibraryCard from './LibraryCard.astro';
import WatchLibrary from './WatchLibrary.astro';

type Category = 'movies' | 'series' | 'music';
interface Props { lang: 'zh' | 'en'; category: Category; }
const { lang, category } = Astro.props;
const isZh = lang === 'zh';
const t = (zh: string, en: string) => (isZh ? zh : en);
const categories = {
	music: { title: t('音樂', 'Music'), description: t('聽過並收藏的專輯、EP 與單曲，依最近添加排序。', 'Albums, EPs, and singles I have listened to and saved, sorted by most recently added.') },
	movies: { title: t('電影', 'Movies'), description: t('看過與想記住的電影，依最近添加排序。', 'Films I have watched and want to remember, sorted by most recently added.') },
	series: { title: t('電視劇／動畫', 'Series / Anime'), description: t('追過的劇集與動畫，依最近添加排序。', 'Series and anime I have followed, sorted by most recently added.') },
};
const current = categories[category];
const allEntries = await getCollection('library', ({ data }) => data.lang === lang && data.kind === category);
const formalEntries = allEntries.filter((entry) => !entry.data.demo);
const entries = (formalEntries.length > 0 ? formalEntries : allEntries).sort((a, b) => {
	if (category === 'music') {
		return b.data.addedAt.valueOf() - a.data.addedAt.valueOf() || (a.data.listOrder ?? Number.MAX_SAFE_INTEGER) - (b.data.listOrder ?? Number.MAX_SAFE_INTEGER);
	}
	if (a.data.listOrder !== undefined || b.data.listOrder !== undefined) {
		return (a.data.listOrder ?? Number.MAX_SAFE_INTEGER) - (b.data.listOrder ?? Number.MAX_SAFE_INTEGER);
	}
	return b.data.addedAt.valueOf() - a.data.addedAt.valueOf();
});
const artistGroups = category === 'music'
	? Array.from(Map.groupBy(entries, (entry) => entry.data.creator), ([artist, items]) => ({ artist, items }))
		.sort((a, b) => a.artist.localeCompare(b.artist, isZh ? 'zh-Hant' : 'en'))
	: [];
const albumGroups = category === 'music'
	? Array.from(
		Map.groupBy(entries, (entry) => entry.data.album ?? (['album', 'ep', 'single'].includes(entry.data.releaseType ?? '') ? entry.data.title : t('其他單曲', 'Other Singles'))),
		([album, items]) => ({ album, items, cover: items.find((entry) => entry.data.coverImage) ?? items[0] }),
	).sort((a, b) => a.album.localeCompare(b.album, isZh ? 'zh-Hant' : 'en'))
	: [];
const songEntries = category === 'music'
	? entries.filter((entry) => entry.data.releaseType === 'song' || entry.data.releaseType === 'single')
	: [];
---

<ArticleLayout
	lang={lang}
	title={current.title}
	description={current.description}
	canonicalPath={`/${lang}/library/${category}/`}
	translationPath={`/${isZh ? 'en' : 'zh'}/library/${category}/`}
	section="library"
	socialImagePath={`/og/library-${lang}.jpg`}
	socialImageAlt={t('Hunghsuan 個人收藏庫', 'Hunghsuan Personal Library')}
>
	<main class="category-main">
		<header class="category-hero">
			<a href={`/${lang}/library/`} data-reveal="left">← {t('返回收藏庫', 'BACK TO LIBRARY')}</a>
			<div class="category-heading">
				<div class="category-meta" data-reveal><span>{t('個人選藏', 'PERSONAL LIBRARY')}</span><span>{t('最近添加 ↓', 'RECENTLY ADDED ↓')}</span></div>
				<h1 data-reveal style="--reveal-delay: 60ms;">{current.title}</h1>
				<p data-reveal style="--reveal-delay: 120ms;">{current.description}</p>
			</div>
		</header>

		<nav class="category-tabs" aria-label={t('收藏庫分類', 'Library categories')}>
			{(Object.keys(categories) as Category[]).map((key) => <a href={`/${lang}/library/${key}/`} aria-current={key === category ? 'page' : undefined}>{categories[key].title}</a>)}
		</nav>

		<section class:list={['category-list', category === 'music' && 'music-library']} aria-label={current.title} data-music-library={category === 'music' ? '' : undefined}>
			<div class="category-summary"><span>{String(entries.length).padStart(2, '0')} {t('項收藏', 'ITEMS')}</span><span>{t('依最近添加排序', 'SORTED BY DATE ADDED')}</span></div>

			{category === 'music' ? (
				<>
					<div class="music-view-tabs" role="tablist" aria-label={t('音樂檢視', 'Music views')}>
						<button type="button" role="tab" aria-selected="true" data-view-target="recent">{t('最近添加', 'Recently Added')}</button>
						<button type="button" role="tab" aria-selected="false" data-view-target="artists">{t('歌手', 'Artists')}</button>
						<button type="button" role="tab" aria-selected="false" data-view-target="albums">{t('專輯', 'Albums')}</button>
						<button type="button" role="tab" aria-selected="false" data-view-target="songs">{t('單曲', 'Songs')}</button>
					</div>

					<div class="music-view" role="tabpanel" data-view-panel="recent">
						<div class="category-grid">
							{entries.map((entry, index) => <div class="category-item" data-reveal style={`--reveal-delay: ${(index % 4) * 60}ms;`}><LibraryCard entry={entry} lang={lang} /></div>)}
						</div>
					</div>

					<div class="music-view" role="tabpanel" data-view-panel="artists" hidden>
						<div class="artist-browser">
							<div class="artist-list" aria-label={t('歌手列表', 'Artist list')}>
								{artistGroups.map(({ artist, items }, index) => (
									<button type="button" class="artist-select" aria-selected={index === 0 ? 'true' : 'false'} data-artist-target={`artist-${index}`}>
										<span class="artist-avatar" aria-hidden="true">{artist.slice(0, 1).toUpperCase()}</span>
										<span>{artist}</span><small>{String(items.length).padStart(2, '0')}</small>
									</button>
								))}
							</div>
							<div class="artist-results">
								{artistGroups.map(({ artist, items }, index) => (
									<section data-artist-panel={`artist-${index}`} hidden={index !== 0}>
										<div class="artist-heading"><p>{t('歌手', 'ARTIST')}</p><h2>{artist}</h2></div>
										<div class="artist-grid">{items.map((entry) => <LibraryCard entry={entry} lang={lang} />)}</div>
									</section>
								))}
							</div>
						</div>
					</div>

					<div class="music-view" role="tabpanel" data-view-panel="albums" hidden>
						<div class="album-grid">
							{albumGroups.map(({ album, items, cover }) => (
								<a class="album-card" href={cover.data.externalUrl} target={cover.data.externalUrl ? '_blank' : undefined} rel={cover.data.externalUrl ? 'noreferrer' : undefined}>
									<div class="album-artwork">
										{cover.data.coverImage ? <img src={cover.data.coverImage} alt="" loading="lazy" decoding="async" /> : <span>{album.slice(0, 1).toUpperCase()}</span>}
									</div>
									<h2>{album}</h2>
									<p>{items[0].data.creator}</p>
									<small>{items.length > 1 ? `${items.length} ${t('首歌曲', 'songs')}` : t('1 首歌曲', '1 song')}</small>
								</a>
							))}
						</div>
					</div>

					<div class="music-view" role="tabpanel" data-view-panel="songs" hidden>
						<div class="song-table-wrap">
							<table class="song-table">
								<thead><tr><th>#</th><th>{t('名稱', 'Title')}</th><th>{t('歌手', 'Artist')}</th><th>{t('專輯', 'Album')}</th><th>{t('年份', 'Year')}</th><th>{t('時間', 'Time')}</th></tr></thead>
								<tbody>
									{songEntries.map((entry, index) => (
										<tr>
											<td>{String(index + 1).padStart(2, '0')}</td>
											<td><a href={entry.data.externalUrl} target={entry.data.externalUrl ? '_blank' : undefined} rel={entry.data.externalUrl ? 'noreferrer' : undefined}>{entry.data.title}</a></td>
											<td>{entry.data.creator}</td><td>{entry.data.album ?? '—'}</td><td>{entry.data.releaseYear}</td><td>{entry.data.duration ?? '—'}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</div>
				</>
			) : (
				<WatchLibrary entries={entries} lang={lang} />
			)}
		</section>
	</main>
</ArticleLayout>

<script>
	document.querySelectorAll<HTMLElement>('[data-music-library]').forEach((library) => {
		const tabs = Array.from(library.querySelectorAll<HTMLButtonElement>('[data-view-target]'));
		const panels = Array.from(library.querySelectorAll<HTMLElement>('[data-view-panel]'));
		const validViews = tabs.map((tab) => tab.dataset.viewTarget);
		const setView = (view = 'recent') => {
			if (!validViews.includes(view)) view = 'recent';
			tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.viewTarget === view)));
			panels.forEach((panel) => { panel.hidden = panel.dataset.viewPanel !== view; });
		};
		tabs.forEach((tab) => tab.addEventListener('click', () => {
			const view = tab.dataset.viewTarget ?? 'recent';
			setView(view);
			history.replaceState(null, '', view === 'recent' ? location.pathname : `#${view}`);
		}));
		setView(location.hash.slice(1) || 'recent');

		const artistButtons = Array.from(library.querySelectorAll<HTMLButtonElement>('[data-artist-target]'));
		const artistPanels = Array.from(library.querySelectorAll<HTMLElement>('[data-artist-panel]'));
		artistButtons.forEach((button) => button.addEventListener('click', () => {
			const artist = button.dataset.artistTarget;
			artistButtons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));
			artistPanels.forEach((panel) => { panel.hidden = panel.dataset.artistPanel !== artist; });
		}));
	});
</script>

<style>
	.category-main { min-height: calc(100vh - 84px); }
	.category-hero { display: grid; grid-template-columns: minmax(180px, .36fr) minmax(0, 1fr); gap: 32px clamp(40px, 8vw, 130px); padding: clamp(70px, 9vw, 130px) clamp(24px, 7vw, 112px); border-bottom: 1px solid var(--line); }
	.category-hero > a { align-self: start; padding-top: 14px; color: var(--accent-text); font-size: .6rem; font-weight: 850; letter-spacing: .15em; text-decoration: none; }
	.category-meta { display: flex; flex-wrap: wrap; gap: 10px 20px; color: var(--accent-text); font-size: .58rem; font-weight: 850; letter-spacing: .16em; }
	.category-meta span:first-child { padding: 5px 8px; color: var(--forest-deep); background: var(--acid); }
	.category-heading h1 { margin: 24px 0 0; font-size: clamp(3.6rem, 8.5vw, 8.5rem); font-weight: 900; letter-spacing: var(--tracking-display); line-height: .88; text-wrap: balance; }
	.category-heading > p { max-width: 680px; margin: 34px 0 0; font-family: var(--serif); font-size: clamp(1.05rem, 1.7vw, 1.35rem); line-height: 1.7; }
	.category-tabs { display: flex; gap: 8px; overflow-x: auto; padding: 26px clamp(24px, 7vw, 112px); border-bottom: 1px solid var(--line); }
	.category-tabs a { padding: 9px 14px; border: 1px solid var(--line-strong); font-size: .6rem; font-weight: 850; letter-spacing: .13em; text-decoration: none; white-space: nowrap; }
	.category-tabs a[aria-current="page"] { color: var(--paper); background: var(--ink); }
	.category-list { padding: clamp(56px, 7vw, 96px) clamp(24px, 7vw, 112px) clamp(80px, 10vw, 140px); }
	.category-summary { display: flex; justify-content: space-between; gap: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--line-strong); color: var(--muted); font-size: .58rem; font-weight: 850; letter-spacing: .15em; }
	.category-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(34px, 5vw, 72px) clamp(18px, 2.5vw, 38px); padding-top: 38px; }
	.music-view-tabs { display: flex; gap: 8px; overflow-x: auto; padding: 24px 0; border-bottom: 1px solid var(--line); }
	.music-view-tabs button { padding: 10px 15px; border: 1px solid var(--line-strong); color: inherit; background: transparent; font: inherit; font-size: .65rem; font-weight: 850; letter-spacing: .1em; cursor: pointer; white-space: nowrap; }
	.music-view-tabs button[aria-selected="true"] { color: var(--paper); background: var(--ink); }
	.music-view[hidden], [data-artist-panel][hidden] { display: none; }
	.artist-browser { display: grid; grid-template-columns: minmax(210px, .28fr) minmax(0, 1fr); min-height: 540px; margin-top: 38px; border: 1px solid var(--line-strong); }
	.artist-list { max-height: 650px; overflow-y: auto; border-right: 1px solid var(--line-strong); }
	.artist-select { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; align-items: center; gap: 10px; width: 100%; padding: 12px 14px; border: 0; border-bottom: 1px solid var(--line); color: inherit; background: transparent; font: inherit; text-align: left; cursor: pointer; }
	.artist-select[aria-selected="true"] { background: color-mix(in srgb, var(--ink) 9%, transparent); }
	.artist-select > span:nth-child(2) { overflow: hidden; font-size: .72rem; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
	.artist-select small { color: var(--muted); font-size: .55rem; }
	.artist-avatar { display: grid; width: 34px; aspect-ratio: 1; place-items: center; border-radius: 50%; color: var(--forest-deep); background: var(--acid); font-size: .62rem; font-weight: 900; }
	.artist-results { padding: clamp(24px, 4vw, 54px); }
	.artist-heading p { margin: 0 0 8px; color: var(--muted); font-size: .55rem; font-weight: 850; letter-spacing: .14em; }
	.artist-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 4.4rem); letter-spacing: var(--tracking-display); line-height: 1; }
	.artist-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 20px; margin-top: 38px; }
	.album-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 38px clamp(16px, 2.5vw, 34px); padding-top: 38px; }
	.album-card { min-width: 0; color: inherit; text-decoration: none; }
	.album-artwork { display: grid; overflow: hidden; aspect-ratio: 1; place-items: center; border: 1px solid var(--line-strong); color: var(--forest-deep); background: var(--acid); font-size: 2rem; font-weight: 900; }
	.album-artwork img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
	.album-card:hover .album-artwork img { transform: scale(1.025); }
	.album-card h2 { overflow: hidden; margin: 14px 0 5px; font-size: .82rem; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
	.album-card p, .album-card small { display: block; overflow: hidden; margin: 0; color: var(--muted); font-size: .66rem; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
	.song-table-wrap { overflow-x: auto; margin-top: 38px; border: 1px solid var(--line-strong); }
	.song-table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: .72rem; }
	.song-table th, .song-table td { padding: 12px 14px; border-bottom: 1px solid var(--line); text-align: left; }
	.song-table th { color: var(--muted); font-size: .54rem; letter-spacing: .12em; text-transform: uppercase; }
	.song-table tbody tr:nth-child(even) { background: color-mix(in srgb, var(--ink) 4%, transparent); }
	.song-table td:first-child, .song-table td:nth-last-child(-n+2) { color: var(--muted); font-variant-numeric: tabular-nums; }
	.song-table a { color: inherit; font-weight: 800; text-decoration: none; }
	@media (max-width: 1000px) { .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	@media (max-width: 1000px) { .album-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } .artist-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 720px) { .category-hero { grid-template-columns: 1fr; } .category-hero > a { padding-top: 0; } .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .artist-browser { grid-template-columns: 1fr; } .artist-list { display: flex; max-height: none; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--line-strong); } .artist-select { min-width: 190px; border-right: 1px solid var(--line); border-bottom: 0; } .album-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
	@media (max-width: 440px) { .category-grid { grid-template-columns: 1fr; } .category-item { width: min(100%, 310px); } .category-summary { flex-direction: column; gap: 4px; } .album-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .artist-results { padding: 24px 18px; } }
</style>
