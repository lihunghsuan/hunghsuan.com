---
import type { CollectionEntry } from 'astro:content';
interface Props { entries: CollectionEntry<'library'>[]; lang: 'zh' | 'en'; }
const { entries, lang } = Astro.props;
const t = (zh: string, en: string) => lang === 'zh' ? zh : en;
const filters = [['all', t('全部', 'All')], ['saved', t('想看', 'Want to watch')], ['watching', t('在看', 'Watching')], ['watched', t('看過', 'Watched')]];
---
<div data-watch-library>
 <div class="watch-filters" aria-label={t('觀看狀態', 'Viewing status')}>
  {filters.map(([value, label]) => <button type="button" data-watch-filter={value} aria-pressed={value === 'all'}>{label}<span>{entries.filter(e => value === 'all' || e.data.status === value).length}</span></button>)}
 </div>
 <div class="watch-grid">
  {entries.map(({data}) => <article class="watch-card" data-watch-status={data.status}>
   <a class="poster" href={data.externalUrl} target="_blank" rel="noreferrer" aria-label={data.title}>
    {data.coverImage ? <img src={data.coverImage} alt={data.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <span>{data.title}</span>}
   </a>
   <div class="watch-copy"><h2><a href={data.externalUrl} target="_blank" rel="noreferrer">{data.title}</a></h2><p class="description">{data.description}</p><p>{data.releaseYear} · {data.platform ?? data.creator}</p><p class="progress">{data.progress ?? (data.status === 'saved' ? t('想看', 'Want to watch') : t('在看', 'Watching'))}</p></div>
  </article>)}
 </div>
 <p class="empty" hidden>{t('這個分類暫時沒有作品。', 'No titles in this category yet.')}</p>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-watch-library]').forEach(root => {
  const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-watch-filter]'));
  const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-watch-status]'));
  buttons.forEach(button => button.addEventListener('click', () => {
   buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
   cards.forEach(card => { card.hidden = button.dataset.watchFilter !== 'all' && card.dataset.watchStatus !== button.dataset.watchFilter; });
   const empty = root.querySelector<HTMLElement>('.empty');
   if (empty) empty.hidden = cards.some(card => !card.hidden);
  }));
 });
</script>
<style>
 .watch-filters { display:flex; flex-wrap:wrap; gap:8px; padding:24px 0 32px; }
 button { color:var(--ink); background:transparent; border:1px solid var(--line-strong); padding:10px 14px; font:inherit; cursor:pointer; }
 button[aria-pressed="true"] { background:var(--ink); color:var(--paper); }
 button span { margin-left:10px; font-size:.75em; opacity:.7; }
 .watch-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:32px 24px; }
 .watch-card { display:grid; grid-template-columns:minmax(90px,.8fr) minmax(0,1fr); gap:16px; }
 .watch-card[hidden], .empty[hidden] { display:none; }
 a { color:inherit; text-decoration:none; }
 .poster { display:grid; align-items:center; aspect-ratio:2/3; overflow:hidden; background:var(--line); }
 .poster img { width:100%; height:100%; object-fit:cover; }
 .poster span { padding:12px; font-size:.9rem; }
 h2 { margin:0 0 12px; font-size:1rem; line-height:1.45; }
 p { color:var(--muted); font-size:.75rem; line-height:1.6; margin:8px 0; }
 .description { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
 .progress { color:var(--ink); }
 @media(max-width:1100px) { .watch-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
 @media(max-width:650px) { .watch-grid { grid-template-columns:1fr; } .watch-card { grid-template-columns:110px minmax(0,1fr); } }
</style>
