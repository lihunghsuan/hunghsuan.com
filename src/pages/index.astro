---
const chineseURL = new URL('/zh/', Astro.site);
const englishURL = new URL('/en/', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, follow" />
		<link rel="alternate" hreflang="zh-Hant" href={chineseURL} />
		<link rel="alternate" hreflang="en" href={englishURL} />
		<link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
		<title>Hunghsuan — Choose your language</title>
		<script is:inline>
			(() => {
				const systemLanguage = navigator.languages?.[0] || navigator.language || 'en';
				let language = systemLanguage.toLowerCase().startsWith('zh') ? 'zh' : 'en';

				try {
					const savedLanguage = localStorage.getItem('language-preference');
					if (savedLanguage === 'zh' || savedLanguage === 'en') language = savedLanguage;
				} catch {}

				const target = language === 'zh' ? '/zh/' : '/en/';
				window.location.replace(`${target}${window.location.search}${window.location.hash}`);
			})();
		</script>
		<style>
			:root {
				color-scheme: light dark;
				font-family: Inter, ui-sans-serif, system-ui, sans-serif;
			}

			body {
				display: grid;
				min-height: 100vh;
				margin: 0;
				place-items: center;
				background: #101713;
				color: #f1eee5;
			}

			main {
				padding: 32px;
				text-align: center;
			}

			a {
				display: inline-block;
				margin: 8px;
				padding: 12px 18px;
				border: 1px solid currentColor;
				color: inherit;
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Hunghsuan</h1>
			<p>選擇語言 · Choose your language</p>
			<a href="/zh/">繁體中文</a>
			<a href="/en/">English</a>
		</main>
	</body>
</html>
